# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key  # Required for server-side inserts (bypasses RLS)

# Allowed frontend origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:8000,http://localhost:3000

# Server
PORT=3001
