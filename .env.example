# NIFES Study Hub — Environment Variables Example
# Copy this file to .env and fill in your Supabase credentials:
#   cp .env.example .env
#
# Note: .env is gitignored and will never be pushed to your repository.
# For Vercel, configure these under Project Settings > Environment Variables.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SERVER_URL=https://nifes-study-hub-server.up.railway.app
